{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "loomi-examples",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8731"],
      "port": 8731
    },
    {
      "name": "loomi-examples-cc",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8732"],
      "port": 8732
    },
    {
      "name": "loomi-docs",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd ../docs && npx astro dev --port 4321 --host"],
      "port": 4321
    },
    {
      "name": "loomi-docs-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd ../docs && npx astro preview --port 4324 --host"],
      "port": 4324
    },
    {
      "name": "loomi-forms-preview",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "./node_modules/.pnpm/@web+dev-server@0.4.6/node_modules/@web/dev-server/dist/bin.js",
        "--root-dir", ".", "--config", "web-dev-server.config.mjs", "--port", "8733"
      ],
      "port": 8733
    },
    {
      "name": "loomi-forms-preview-cc",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "./node_modules/.pnpm/@web+dev-server@0.4.6/node_modules/@web/dev-server/dist/bin.js",
        "--root-dir", ".", "--config", "web-dev-server.config.mjs", "--port", "8739"
      ],
      "port": 8739
    }
  ]
}
