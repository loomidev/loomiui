{
  "name": "@loomidev/chat",
  "version": "0.4.1",
  "description": "Chat window and message bubbles for one-to-one and group conversations.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/chat"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loomi-chat-message.js": {
      "types": "./dist/loomi-chat-message.d.ts",
      "import": "./dist/loomi-chat-message.js"
    },
    "./loomi-chat-window.js": {
      "types": "./dist/loomi-chat-window.d.ts",
      "import": "./dist/loomi-chat-window.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-styles.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-styles.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/avatar": "workspace:^",
    "@loomidev/button": "workspace:^",
    "@loomidev/core": "workspace:^",
    "@loomidev/dropmenu": "workspace:^",
    "@loomidev/icon": "workspace:^",
    "@loomidev/spinner": "workspace:^",
    "@loomidev/tooltip": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@loomidev/theme": "workspace:^",
    "@tailwindcss/cli": "^4.0.0",
    "lit": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "chat",
    "message"
  ],
  "customElements": "custom-elements.json"
}
