{
  "name": "@loomidev/content",
  "version": "0.2.0",
  "description": "All loomi content/data-display components in one install.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/content"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/card": "workspace:^",
    "@loomidev/divider": "workspace:^",
    "@loomidev/qrcode": "workspace:^",
    "@loomidev/avatar": "workspace:^",
    "@loomidev/accordion": "workspace:^",
    "@loomidev/arc-meter": "workspace:^",
    "@loomidev/tag": "workspace:^",
    "@loomidev/tooltip": "workspace:^",
    "@loomidev/popover": "workspace:^",
    "@loomidev/empty-state": "workspace:^",
    "@loomidev/statistic": "workspace:^",
    "@loomidev/rating": "workspace:^",
    "@loomidev/scroller": "workspace:^",
    "@loomidev/timeline": "workspace:^",
    "@loomidev/progress": "workspace:^",
    "@loomidev/listview": "workspace:^",
    "@loomidev/contact-card": "workspace:^",
    "@loomidev/centered-content": "workspace:^",
    "@loomidev/sortable": "workspace:^",
    "@loomidev/processing": "workspace:^",
    "@loomidev/horizontal-line-graph": "workspace:^",
    "@loomidev/chart": "workspace:^",
    "@loomidev/chat": "workspace:^",
    "@loomidev/calendar": "workspace:^",
    "@loomidev/data-grid": "workspace:^",
    "@loomidev/video": "workspace:^",
    "@loomidev/photo-gallery": "workspace:^",
    "@loomidev/lightbox": "workspace:^",
    "@loomidev/timer": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "lit": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "content"
  ]
}
