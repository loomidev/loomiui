        {
          "kind": "class",
          "description": "`<loomi-button-group>` — a shrink-wrapped segmented row of toggle buttons.\n\nPlace `<loomi-button-group-item>` elements as children. The group uses the same\ntinted track, inner gap, selected surface, accent text, and selected shadow as\n`<loomi-tabs tab-style=\"system\">`, but the bar is `inline-flex` so it ends with the\nlast button instead of stretching across the parent.",
          "name": "LoomiButtonGroup",
          "slots": [
            {
              "description": "`<loomi-button-group-item>` children.",
              "name": ""
            }
          ],
