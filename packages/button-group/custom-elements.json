        {
          "kind": "class",
          "description": "`<loomi-button-group-item>` — a single button within a `<loomi-button-group>`.\n\nSet `label` for button text, `icon` for a built-in icon name, `icon-right` to place\nthe icon after the label, `icon-only` to visually hide the label, `selected` to mark\nthis item as active, and `disabled` to disable just this item. The `value` attribute\nis surfaced in the `loomi-button-group-change` event emitted by the parent.",
          "name": "LoomiButtonGroupItem",
          "slots": [
            {
              "description": "Button label text (used when the `label` attribute is absent).",
              "name": ""
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "label",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
              "description": "Button label text. Falls back to slot text if empty.",
              "attribute": "label"
            },
            {
              "kind": "field",
              "name": "icon",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
              "description": "Built-in icon name to render (same registry as `<loomi-button>`).",
              "attribute": "icon"
            },
            {
              "kind": "field",
              "name": "iconRight",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "description": "Place the icon after the label instead of before it.",
              "attribute": "icon-right"
            },
            {
              "kind": "field",
              "name": "iconOnly",
              "type": {
                "text": "boolean"
              },
              "default": "false",
              "description": "Visually hide the label and render this item as a square icon button.",
              "attribute": "icon-only",
              "reflects": true
            },
            {
              "kind": "field",
              "name": "accessibilityLabel",
              "type": {
                "text": "string"
