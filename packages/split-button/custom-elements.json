        {
          "kind": "class",
          "description": "`<loomi-split-button>` — a primary action joined to a caret that opens a menu of\nrelated actions (\"Create course ▾\" → Import courses, Course templates).\n\nBoth halves are real `<loomi-button>`s, so every visual attribute below behaves exactly\nas it does on a plain button and the two halves can't drift apart. Menu rows are\n`<loomi-dropmenu-item>`s, so item styling, icons, shortcuts, checkbox/radio rows and\ndestructive variants all come along unchanged.\n\nThe panel is promoted to the **top layer** via the popover API and placed with core's\n`positionFloatingPanel()` — the same mechanism `<loomi-dropmenu>` uses — so it is never\nclipped by an ancestor's `overflow`. That's what makes this usable in table rows and\ncard headers.",
          "name": "LoomiSplitButton",
          "cssParts": [
            {
              "description": "The wrapper holding both halves.",
              "name": "split"
            },
            {
              "description": "The primary half (`<loomi-button>` host).",
              "name": "primary"
            },
            {
              "description": "The primary half's inner `<button>`/`<a>`.",
              "name": "primary-button"
            },
            {
              "description": "The hairline between the two halves.",
              "name": "divider"
            },
            {
              "description": "The caret half (`<loomi-button>` host).",
              "name": "caret"
            },
            {
              "description": "The caret's inner `<button>`.",
              "name": "caret-button"
            },
            {
              "description": "The floating menu panel.",
              "name": "panel"
            }
          ],
          "slots": [
            {
              "description": "The primary half's label.",
              "name": ""
            },
            {
              "description": "`<loomi-dropmenu-item>` rows for the caret's menu.",
              "name": "menu"
            }
          ],
          "members": [
