        {
          "kind": "class",
          "description": "`<loomi-countries>` — a searchable country dropdown with flag icons next to each\nname. Defaults to a full country list (`mode=\"names\"`); set `mode=\"phone\"` to show\njust the selected country's flag + dial code beside a phone-number input instead.\n\n`selection` accepts a country name, ISO 3166-1 alpha-2 code, or dial code, and the\nproperty reflects back to the resolved alpha-2 code once a match is found.\n\nForm-associated: submits the alpha-2 code under `name` in `names` mode, or\n`<dial code><number>` in `phone` mode. The phone-mode number field always accepts\ndigits only, and auto-formats them using the selected country's typical national\nnumber layout (e.g. picking Ghana formats \"241234567\" as `(241)234-567`) — set\n`mask` (same Alpine-style `9`/`a`/`*` syntax as `<loomi-input>`'s `mask`) to override it.",
          "name": "LoomiCountries",
          "cssParts": [
            {
              "description": "The bordered container (`phone` mode only).",
              "name": "field"
            },
            {
              "description": "The clickable trigger / flag button.",
              "name": "trigger"
            },
            {
              "description": "The dropdown panel.",
              "name": "panel"
            },
            {
              "description": "The phone number `<input>` (`phone` mode only).",
              "name": "input"
            }
          ],
