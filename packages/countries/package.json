{
  "name": "@loomidev/countries",
  "version": "0.1.0",
  "description": "<loomi-countries> — a searchable country dropdown with flag icons, plus a phone-number mode (flag + dial code + number input).",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/countries"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loomi-countries.js": {
      "types": "./dist/loomi-countries.d.ts",
      "import": "./dist/loomi-countries.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-data.mjs && node scripts/build-styles.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-data.mjs && node scripts/build-styles.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/core": "workspace:^",
    "@loomidev/theme": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "circle-flags": "^2.8.3",
    "country-telephone-data": "^0.6.3",
    "lit": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "form",
    "select",
    "dropdown",
    "country",
    "countries",
    "flag",
    "phone"
  ]
}
