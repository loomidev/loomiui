{
  "name": "@loomidev/date-range-picker",
  "version": "0.1.0",
  "description": "<loomi-date-range-picker> — a reporting-friendly range control for dashboards, tables, and billing views.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/date-range-picker"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loomi-date-range-picker.ts": {
      "types": "./dist/loomi-date-range-picker.d.ts",
      "import": "./dist/loomi-date-range-picker.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/button": "workspace:^",
    "@loomidev/core": "workspace:^",
    "@loomidev/datepicker": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "lit": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "date",
    "range",
    "picker"
  ],
  "customElements": "custom-elements.json"
}
