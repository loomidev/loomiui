{
  "name": "@loomidev/horizontal-line-graph",
  "version": "0.1.0",
  "description": "<loomi-horizontal-line-graph> — a labeled proportion bar.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/horizontal-line-graph"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loomi-horizontal-line-graph.js": {
      "types": "./dist/loomi-horizontal-line-graph.d.ts",
      "import": "./dist/loomi-horizontal-line-graph.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-styles.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-styles.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/core": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@loomidev/theme": "workspace:^",
    "@tailwindcss/cli": "^4.0.0",
    "lit": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "graph",
    "chart"
  ],
  "customElements": "custom-elements.json"
}
