{
  "name": "@loomi/textarea",
  "version": "0.1.0",
  "description": "loomi <loomi-textarea> — a themeable multi-line text input web component with floating labels.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loomi-textarea.js": {
      "types": "./dist/loomi-textarea.d.ts",
      "import": "./dist/loomi-textarea.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-styles.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-styles.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomi/core": "workspace:^",
    "@loomi/theme": "workspace:^",
    "quill": "^2.0.3"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "lit": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomi",
    "form",
    "textarea",
    "comment"
  ]
}
