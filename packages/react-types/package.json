{
  "name": "@loomidev/react-types",
  "version": "0.0.0",
  "description": "TypeScript JSX declarations for using LoomiUI custom elements in React 18 and React 19.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/react-types"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "node scripts/generate-react-types.mjs",
    "build": "node scripts/generate-react-types.mjs && tsc -p tsconfig.json",
    "typecheck": "node scripts/generate-react-types.mjs && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.react19.json"
  },
  "dependencies": {
    "@loomidev/components": "workspace:^",
    "@loomidev/core": "workspace:^"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "loomiui",
    "react",
    "typescript",
    "jsx",
    "web-components"
  ]
}
