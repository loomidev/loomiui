{
  "name": "@loomidev/bottom-nav",
  "version": "0.4.1",
  "description": "<loomi-bottom-nav>/<loomi-bottom-nav-item> — a mobile bottom navigation bar with badges, active-state styles, and framework-agnostic routing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/bottom-nav"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loomi-bottom-nav.js": {
      "types": "./dist/loomi-bottom-nav.d.ts",
      "import": "./dist/loomi-bottom-nav.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-styles.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-styles.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/core": "workspace:^",
    "@loomidev/icon": "workspace:^",
    "@loomidev/icons": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@loomidev/theme": "workspace:^",
    "@tailwindcss/cli": "^4.3.3",
    "lit": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "bottom-nav",
    "navigation",
    "mobile",
    "tab-bar"
  ],
  "customElements": "custom-elements.json"
}
