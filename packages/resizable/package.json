{
  "name": "@loomidev/resizable",
  "version": "0.4.1",
  "description": "<loomi-resizable-panel-group> — resizable split-pane layouts with draggable handles.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/resizable"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loomi-resizable.js": {
      "types": "./dist/loomi-resizable.d.ts",
      "import": "./dist/loomi-resizable.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-styles.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-styles.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/core": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@loomidev/theme": "workspace:^",
    "@tailwindcss/cli": "^4.0.0",
    "lit": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "resizable",
    "split-pane",
    "panel"
  ],
  "customElements": "custom-elements.json"
}
