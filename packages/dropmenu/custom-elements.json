        {
          "kind": "class",
          "description": "`<loomi-dropmenu>` — a dropdown action menu. Trigger via the default ellipsis icon, an\nicon name (`trigger`), or custom markup in the `trigger` slot.\n\nThe panel is promoted to the **top layer** via the popover API and positioned against\nthe viewport, so it is never clipped by an ancestor's `overflow` — that's what makes it\nusable from a row deep inside a scrolling table — and it flips above the trigger when\nthere isn't room below.",
          "name": "LoomiDropmenu",
          "cssParts": [
            {
              "description": "The floating menu panel.",
              "name": "menu"
            }
          ],
          "slots": [
            {
              "description": "`<loomi-dropmenu-item>` children.",
              "name": ""
            },
            {
              "description": "Custom trigger markup.",
              "name": "trigger"
            }
          ],
          "members": [
            {
              "kind": "field",
              "name": "trigger",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
              "attribute": "trigger"
            },
            {
              "kind": "field",
              "name": "label",
              "type": {
                "text": "string"
              },
              "default": "\"\"",
              "description": "Names the trigger and the menu panel for assistive technology.\n\nRequired whenever the trigger is the default icon glyph, which carries no\ntext: the button lives in this component's shadow root, so an `aria-label`\nplaced on the host does not reach it and the control is left unnamed. A\ntrigger slotted with visible text names itself and needs nothing here.",
              "attribute": "label"
            },
            {
              "kind": "field",
              "name": "triggerOn",
              "type": {
                "text": "\"click\" | \"mouseover\""
              },
              "default": "\"click\"",
