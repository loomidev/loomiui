{
  "name": "@loomidev/navigation",
  "version": "0.5.0",
  "description": "All loomi navigation components in one install.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/navigation"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/bottom-nav": "workspace:^",
    "@loomidev/command-palette": "workspace:^",
    "@loomidev/context-menu": "workspace:^",
    "@loomidev/dropmenu": "workspace:^",
    "@loomidev/pagination": "workspace:^",
    "@loomidev/tab": "workspace:^",
    "@loomidev/theme-switcher": "workspace:^",
    "@loomidev/side-nav": "workspace:^",
    "@loomidev/progress-steps": "workspace:^",
    "@loomidev/profile-menu": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "lit": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "navigation"
  ]
}
