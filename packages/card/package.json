{
  "name": "@loomidev/card",
  "version": "0.1.0",
  "description": "<loomi-card> — a content card with optional title, header and footer slots.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loomi-card.js": {
      "types": "./dist/loomi-card.d.ts",
      "import": "./dist/loomi-card.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-styles.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-styles.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/core": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@loomidev/theme": "workspace:^",
    "@tailwindcss/cli": "^4.0.0",
    "lit": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "card"
  ]
}
