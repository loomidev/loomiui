        {
          "kind": "class",
          "description": "`<loomi-tooltip>` — shows a tooltip on hover/focus of its trigger content.\n\nThe tip is promoted to the **top layer** via the popover API and placed in viewport\ncoordinates, so an ancestor with `overflow` (a table's scroll wrapper, a card) neither\nclips it nor grows a scrollbar to make room for it. Near a viewport edge it flips to the\nopposite side and shifts along the edge, keeping its arrow on the trigger.",
          "name": "LoomiTooltip",
          "slots": [
            {
              "description": "The trigger element(s).",
              "name": ""
            },
            {
              "description": "Rich tooltip content (overrides the `content` attribute).",
              "name": "content"
            }
          ],
          "members": [
            {
              "kind": "field",
