{
  "name": "@loomidev/text-editor",
  "version": "0.4.1",
  "description": "<loomi-text-editor> — a themeable rich-text editor web component with configurable tools, a floating label, and inline validation.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/text-editor"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loomi-text-editor.js": {
      "types": "./dist/loomi-text-editor.d.ts",
      "import": "./dist/loomi-text-editor.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-styles.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-styles.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/core": "workspace:^",
    "@loomidev/filepicker": "workspace:^",
    "@loomidev/icon": "workspace:^",
    "@loomidev/input": "workspace:^",
    "@loomidev/modal": "workspace:^",
    "@loomidev/notification": "workspace:^",
    "@loomidev/select": "workspace:^",
    "@loomidev/theme": "workspace:^",
    "@loomidev/tooltip": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "lit": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "form",
    "rich-text",
    "editor"
  ],
  "customElements": "custom-elements.json"
}
