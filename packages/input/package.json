{
  "name": "@loomidev/input",
  "version": "0.1.0",
  "description": "<loomi-input> — a themeable text input web component with floating labels, prefixes/suffixes, icons and validation.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/input"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loomi-input.js": {
      "types": "./dist/loomi-input.d.ts",
      "import": "./dist/loomi-input.js"
    }
  },
  "scripts": {
    "build": "node scripts/build-styles.mjs && tsc -p tsconfig.json",
    "dev": "node scripts/build-styles.mjs && tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/core": "workspace:^",
    "@loomidev/icons": "workspace:^",
    "@loomidev/notification": "workspace:^",
    "@loomidev/popover": "workspace:^",
    "@loomidev/theme": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "lit": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "form",
    "input",
    "textbox"
  ],
  "customElements": "custom-elements.json"
}
