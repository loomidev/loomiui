        {
          "kind": "class",
          "description": "`<loomi-video>` — a themeable wrapper around the native `<video>` element. Renders the\nbrowser's real media element under the hood (so every codec/format/network quirk is\nhandled by the platform), and layers a themeable, keyboard-accessible control bar on\ntop — built from `@loomidev/button` and `@loomidev/slider` — instead of the raw native\ncontrol UI. Set `controls` to opt into it; without it, this is just a styled `<video>`.\n\n`<source>` and `<track>` children are moved onto the real internal `<video>` element\n(Shadow DOM slotting can't make a native media element discover them itself), so\nmulti-format fallback and subtitle/caption tracks work exactly like plain HTML.",
          "name": "LoomiVideo",
          "cssParts": [
            {
              "description": "The internal `<video>` element.",
              "name": "video"
            },
            {
              "description": "The control bar container.",
              "name": "controls"
            }
          ],
          "slots": [
            {
              "description": "`<source>`/`<track>` children, forwarded onto the internal `<video>`.",
              "name": ""
            },
            {
              "description": "Replaces the entire built-in control bar with custom markup.",
              "name": "controls"
            }
          ],
          "members": [
