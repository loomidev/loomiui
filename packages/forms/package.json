{
  "name": "@loomidev/forms",
  "version": "0.1.0",
  "description": "All loomi form components in one install.",
  "repository": {
    "type": "git",
    "url": "https://github.com/loomidev/loomiui.git",
    "directory": "packages/forms"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@loomidev/input": "workspace:^",
    "@loomidev/password": "workspace:^",
    "@loomidev/textarea": "workspace:^",
    "@loomidev/text-editor": "workspace:^",
    "@loomidev/select": "workspace:^",
    "@loomidev/checkbox": "workspace:^",
    "@loomidev/radio": "workspace:^",
    "@loomidev/toggle": "workspace:^",
    "@loomidev/number": "workspace:^",
    "@loomidev/slider": "workspace:^",
    "@loomidev/otp": "workspace:^",
    "@loomidev/checkcards": "workspace:^",
    "@loomidev/datepicker": "workspace:^",
    "@loomidev/timepicker": "workspace:^",
    "@loomidev/timezonepicker": "workspace:^",
    "@loomidev/colorpicker": "workspace:^",
    "@loomidev/filepicker": "workspace:^",
    "@loomidev/countries": "workspace:^",
    "@loomidev/creditcard": "workspace:^",
    "@loomidev/date-range-picker": "workspace:^",
    "@loomidev/filter-builder": "workspace:^",
    "@loomidev/autocomplete": "workspace:^",
    "@loomidev/tag-input": "workspace:^",
    "@loomidev/emoji-picker": "workspace:^"
  },
  "peerDependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "lit": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "web-components",
    "lit",
    "loomiui",
    "forms"
  ]
}
