{
  "name": "@loomidev/root",
  "version": "0.0.0",
  "private": true,
  "description": "framework-agnostic Lit web component library",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "pnpm": {
    "comments": {
      "overrides": "Security advisories in transitive dependencies whose own parents have not released a bump yet. All are patch-level except ip-address, which needs 10.3.x to clear its high. Deliberately not overridden: @hono/node-server (fix is a major, and its serve-static path traversal is unreachable — @loomidev/mcp-server uses StdioServerTransport and never starts an HTTP listener) and esbuild 0.27.x (a 0.x minor is potentially breaking for a low-severity, dev-only, Windows-only file read). Drop an entry once the parent dependency ships the fix."
    },
    "overrides": {
      "hono": "^4.12.34",
      "fast-uri": "^3.1.5",
      "js-yaml@3": "^3.15.1",
      "js-yaml@4": "^4.3.1",
      "ip-address": "^10.3.1"
    }
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo && rm -rf node_modules/.cache",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "test": "web-test-runner",
    "lint": "eslint \"packages/**/*.ts\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"**/*.{ts,mjs,js,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,js,css,json,md}\"",
    "audit:quality": "node scripts/audit-component-quality.mjs",
    "quality:readmes": "node scripts/ensure-quality-readmes.mjs",
    "check:bundles": "node scripts/check-category-sync.mjs",
    "check:conflicts": "node scripts/check-no-conflicts.mjs",
    "check:cem": "node scripts/generate-cem.mjs && git diff --exit-code -- \"packages/*/custom-elements.json\"",
    "docs:watch-readmes": "pnpm --dir ../docs run watch:components",
    "cem": "node scripts/generate-cem.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^9",
    "@open-wc/testing": "^4.0.0",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-puppeteer": "^1.0.1",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "globals": "^17.7.0",
    "prettier": "^3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8"
  }
}
