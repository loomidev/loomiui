{
  "name": "@loomidev/root",
  "version": "0.0.0",
  "private": true,
  "description": "framework-agnostic Lit web component library",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo && rm -rf node_modules/.cache",
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "test": "web-test-runner",
    "lint": "eslint \"packages/**/*.ts\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"**/*.{ts,mjs,js,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,js,css,json,md}\"",
    "audit:quality": "node scripts/audit-component-quality.mjs",
    "check:styles": "node scripts/check-generated-styles.mjs",
    "styles:manifest": "node scripts/check-generated-styles.mjs --write",
    "quality:readmes": "node scripts/ensure-quality-readmes.mjs",
    "check:bundles": "node scripts/check-category-sync.mjs",
    "check:conflicts": "node scripts/check-no-conflicts.mjs",
    "check:cem": "node scripts/generate-cem.mjs && git diff --exit-code -- \"packages/*/custom-elements.json\"",
    "docs:watch-readmes": "pnpm --dir ../docs run watch:components",
    "cem": "node scripts/generate-cem.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@eslint/js": "^9",
    "@open-wc/testing": "^4.0.0",
    "@web/dev-server-esbuild": "^1.0.5",
    "@web/dev-server-rollup": "^0.6.4",
    "@web/test-runner": "^0.20.2",
    "@web/test-runner-puppeteer": "^0.18.0",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-prettier": "^9",
    "globals": "^17.7.0",
    "prettier": "^3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8"
  }
}
